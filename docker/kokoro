#!/usr/bin/env python3
"""Kokoro TTS subprocess shim.

Matches the CLI interface that airtime's `KokoroTts` wrapper expects:

    kokoro --model PATH --voices PATH --voice NAME --out PATH
        (text from stdin → WAV at --out)

Wraps `kokoro_onnx.Kokoro` for CPU inference. Sample rate is 24 kHz —
the rest of the airtime pipeline up-samples losslessly via ffmpeg.
"""
import argparse
import sys
import numpy as np
import soundfile as sf
import re

# Import and patch kokoro_onnx
import kokoro_onnx
from kokoro_onnx import Kokoro

# Monkey-patch the _create_audio method to fix the input name bug
# The library uses 'tokens' but ONNX model expects 'input_ids'
_original_create_audio = kokoro_onnx.Kokoro._create_audio

def _patched_create_audio(self, phonemes, voice, speed):
    """Patched version that uses correct input names for ONNX."""
    tokens = np.array(self.tokenizer.tokenize(phonemes), dtype=np.int64)
    if len(tokens) > 510:
        tokens = tokens[:510]
    
    # Get voice style
    style = voice[len(tokens)]
    
    # Prepare inputs with CORRECT names (input_ids not tokens)
    inputs = {
        'input_ids': [[0, *tokens, 0]],
        'style': style,
        'speed': np.array([speed], dtype=np.float32),
    }
    
    audio = self.sess.run(None, inputs)[0]
    # Flatten to 1D array
    if audio.ndim > 1:
        audio = audio.flatten()
    # Return sample_rate from self (it's set in __init__)
    return audio, 24000  # Kokoro uses 24kHz

# Apply the patch
kokoro_onnx.Kokoro._create_audio = _patched_create_audio


def split_text_into_chunks(text, max_phonemes=400):
    """Split text into chunks that fit within phoneme limit.
    
    Tries to split on sentence boundaries first, then on clauses,
    then on words as a last resort.
    """
    from kokoro_onnx.tokenizer import Tokenizer
    
    tokenizer = Tokenizer()
    
    # First check if the whole text fits
    phonemes = tokenizer.phonemize(text, "en-us")
    if len(phonemes) <= max_phonemes:
        return [text]
    
    # Split on sentence boundaries first
    sentences = re.split(r'(?<=[.!?])\s+', text)
    chunks = []
    current_chunk = ""
    
    for sentence in sentences:
        test_chunk = current_chunk + " " + sentence if current_chunk else sentence
        test_phonemes = tokenizer.phonemize(test_chunk, "en-us")
        
        if len(test_phonemes) <= max_phonemes:
            current_chunk = test_chunk
        else:
            # Current chunk is full, save it and start new
            if current_chunk:
                chunks.append(current_chunk)
            current_chunk = sentence
    
    if current_chunk:
        chunks.append(current_chunk)
    
    # Verify all chunks fit
    result = []
    for chunk in chunks:
        phonemes = tokenizer.phonemize(chunk, "en-us")
        if len(phonemes) <= max_phonemes:
            result.append(chunk)
        else:
            # Still too long, split on commas or just truncate
            subchunks = re.split(r'(?<=[,;])\s+', chunk)
            for subchunk in subchunks:
                subphonemes = tokenizer.phonemize(subchunk, "en-us")
                if len(subphonemes) <= max_phonemes:
                    result.append(subchunk)
                else:
                    # Last resort: truncate with ellipsis
                    result.append(subchunk[:100] + "...")
    
    return result if result else [text[:100] + "..."]


def generate_long_audio(kokoro, text, voice, speed, lang):
    """Generate audio for long text by splitting into chunks and appending."""
    chunks = split_text_into_chunks(text)
    
    if len(chunks) == 1:
        # Short text, use normal path
        return kokoro.create(chunks[0], voice=voice, speed=speed, lang=lang)
    
    # Long text: generate each chunk and concatenate audio
    all_audio = []
    sample_rate = 24000
    
    for i, chunk in enumerate(chunks):
        try:
            audio, sr = kokoro.create(chunk, voice=voice, speed=speed, lang=lang)
            # Audio is already flattened by _patched_create_audio
            all_audio.append(audio)
            sample_rate = sr
        except Exception as e:
            print(f"kokoro: chunk {i+1}/{len(chunks)} failed: {e}", file=sys.stderr)
            # Continue with other chunks
    
    if not all_audio:
        # All chunks failed, return silence
        return np.zeros(24000, dtype=np.float32), sample_rate
    
    # Concatenate all audio chunks
    full_audio = np.concatenate(all_audio)
    return full_audio, sample_rate


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--model", required=True, help="path to kokoro-v1.0.onnx")
    parser.add_argument("--voices", required=True, help="path to voices.bin")
    parser.add_argument("--voice", required=True, help="voice id, e.g. af_heart")
    parser.add_argument("--out", required=True, help="WAV output path")
    parser.add_argument("--lang", default="en-us")
    parser.add_argument("--speed", type=float, default=1.0)
    args = parser.parse_args()

    text = sys.stdin.read().strip()
    if not text:
        print("kokoro shim: empty text on stdin", file=sys.stderr)
        return 2

    kokoro = Kokoro(args.model, args.voices)
    
    # Use the long audio generator that splits and appends
    samples, sample_rate = generate_long_audio(
        kokoro, text, voice=args.voice, speed=args.speed, lang=args.lang
    )
    
    sf.write(args.out, samples, sample_rate)
    return 0


if __name__ == "__main__":
    sys.exit(main())
